{
  "hosting": {
    "site": "biofuego",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "package.json",
      "package-lock.json",
      "README.md",
      "extracted_assets/**",
      "scratch/**",
      "**/.*",
      "**/node_modules/**",
      "assets/images/aserrin_macro.jpg",
      "assets/images/fuego_parrilla.jpg",
      "assets/images/misiones_paisaje.jpg",
      "assets/images/pack-5-pastillas.png",
      "assets/images/puck-hero-800.png"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/assets/@(css|js)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/@(images|textures)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}

